diff --git a/os/build.rs b/os/build.rs
index 60d80707..e450cc8f 100644
--- a/os/build.rs
+++ b/os/build.rs
@@ -4,2 +4,2 @@
-//! automatically recompiles when `MANGO_CMDLINE` changes, or when
-//! the embedded initramfs cpio is rebuilt.
+//! automatically recompiles when `MANGO_CMDLINE` or `MANGO_CORE_NUM`
+//! changes, or when the embedded initramfs cpio is rebuilt.
@@ -23,0 +24,11 @@ fn main() {
+    // CORE_NUM is a build-time topology contract. Tracking it here prevents
+    // Cargo from reusing a kernel compiled for a different QEMU CPU count.
+    println!("cargo:rerun-if-env-changed=MANGO_CORE_NUM");
+    let core_num = std::env::var("MANGO_CORE_NUM").unwrap_or_else(|_| String::from("1"));
+    assert!(
+        matches!(core_num.as_str(), "1" | "2" | "4" | "8"),
+        "MANGO_CORE_NUM must be one of 1, 2, 4, or 8; got {:?}",
+        core_num
+    );
+    println!("cargo:rustc-env=MANGO_CORE_NUM={core_num}");
+
diff --git a/os/make/la64.mk b/os/make/la64.mk
index 19499b8a..e40fbb77 100755
--- a/os/make/la64.mk
+++ b/os/make/la64.mk
@@ -11 +11,9 @@ ROOTFS_IMG_DIR := ../fs-img-dir
-CORE_NUM := 1
+# One value drives both Cargo and, in the next batch, every QEMU entry point.
+# Keep non-QEMU boards at the default of one until a board-specific caller
+# deliberately opts into a supported QEMU topology.
+CORE_NUM ?= 1
+VALID_CORE_NUMS := 1 2 4 8
+ifeq ($(filter $(CORE_NUM),$(VALID_CORE_NUMS)),)
+$(error CORE_NUM must be one of $(VALID_CORE_NUMS), got '$(CORE_NUM)')
+endif
+export MANGO_CORE_NUM := $(CORE_NUM)
diff --git a/os/make/rv64.mk b/os/make/rv64.mk
index bce93812..7f0365a6 100755
--- a/os/make/rv64.mk
+++ b/os/make/rv64.mk
@@ -21 +21,9 @@ ROOTFS_IMG_DIR := ../fs-img-dir
-CORE_NUM := 1
+# One value drives both Cargo and, in the next batch, every QEMU entry point.
+# Reject unsupported counts while parsing the Makefile, before Cargo can emit
+# an image whose compiled topology disagrees with the requested machine.
+CORE_NUM ?= 1
+VALID_CORE_NUMS := 1 2 4 8
+ifeq ($(filter $(CORE_NUM),$(VALID_CORE_NUMS)),)
+$(error CORE_NUM must be one of $(VALID_CORE_NUMS), got '$(CORE_NUM)')
+endif
+export MANGO_CORE_NUM := $(CORE_NUM)
