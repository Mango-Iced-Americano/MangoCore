{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "prometheus": {
      "prompt_append": "file://./prompts/planner-policy.md"
    },
    "metis": {
      "prompt_append": "file://./prompts/planner-policy.md"
    },
    "atlas": {
      "model": "opencode-go/deepseek-v4-flash",
      "fallback_models": [
        {
          "model": "opencode/deepseek-v4-flash-free"
        },
        {
          "model": "opencode/qwen3.6-plus-free"
        },
        {
          "model": "opencode/minimax-m2.5-free"
        }
      ],
      "prompt_append": "file://./prompts/executor-policy.md"
    },
    "hephaestus": {
      "prompt_append": "file://./prompts/executor-policy.md"
    },
    "oracle": {
      "prompt_append": "file://./prompts/review-policy.md"
    },
    "momus": {
      "prompt_append": "file://./prompts/review-policy.md"
    }
  },
  "categories": {
    "quick": {
      "prompt_append": "file://./prompts/executor-policy.md"
    },
    "deep": {
      "prompt_append": "file://./prompts/executor-policy.md"
    },
    "unspecified-low": {
      "prompt_append": "file://./prompts/executor-policy.md"
    },
    "unspecified-high": {
      "prompt_append": "file://./prompts/executor-policy.md"
    }
  },
  "skills": {
    "mango-worklog": {
      "path": "file://./skills/mango-worklog",
      "description": "自动维护 oskernel2026-mango 项目的工作日志和可复用经验模式。每次代码修改后触发：更新 Doc/Work_Log.md，并将跨对话的坑/模式沉淀到 references/"
    }
  }
}
